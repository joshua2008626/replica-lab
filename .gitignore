# ===============================================================================
# REPLICA LAB - Comprehensive Git Ignore Rules
# ===============================================================================

# --- Environment & Secret Keys ---
.env
.env.local
.env.*.local
*.pem
*.key

# --- Python & Virtual Environments ---
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/
**/venv/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# --- Node & Frontend Build Artifacts ---
node_modules/
**/node_modules/
frontend/node_modules/
frontend/dist/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- SQLite Database & Journals ---
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
backend/storage/*.db
backend/storage/*.sqlite
backend/storage/*.sqlite3
backend/storage/*.db-journal
backend/storage/*.db-wal
backend/storage/*.db-shm
storage/*.db
storage/*.sqlite

# --- Uploaded Artifacts & Quarantined Binaries ---
backend/storage/uploads/*
!backend/storage/uploads/.gitkeep
storage/uploads/*
!storage/uploads/.gitkeep

# --- IDE & Operating System Files ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
Desktop.ini
*.log
