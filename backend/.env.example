# REPLICA LAB Backend Configuration
PROJECT_NAME="REPLICA LAB"
ENVIRONMENT="development"
DEBUG=true

# Server Host & Port
HOST="127.0.0.1"
PORT=8000

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Storage & Upload Paths
STORAGE_DIR="storage"
UPLOAD_DIR="storage/uploads"
MAX_UPLOAD_SIZE_BYTES=104857600  # 100 MiB limit

# Database
DATABASE_URL="sqlite+aiosqlite:///storage/replica_lab.db"

# REA MCP Engine Settings (Runs as local Streamable HTTP service)
REA_MCP_URL="http://127.0.0.1:8080/mcp"
REA_CONNECT_TIMEOUT_SECONDS=5.0
REA_READ_TIMEOUT_SECONDS=60.0

# Optional AI Providers (Leave blank if running without AI keys)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
AI_MODEL_NAME="gemini-2.5-flash"
